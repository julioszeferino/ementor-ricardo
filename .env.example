# Copie para .env (cp .env.example .env) e ajuste. O .env NUNCA deve ser commitado.
# Valores abaixo são apenas para desenvolvimento local.

# --- Data Warehouse (Postgres) -----------------------------------------------
DW_USER=postgres
DW_PASSWORD=postgres
DW_DATABASE=warehouse

# --- Banco de metadados (Airflow + Metabase) ---------------------------------
APP_DB_USER=app
APP_DB_PASSWORD=app

# --- Airflow ------------------------------------------------------------------
# Linux: AIRFLOW_UID=$(id -u). No macOS pode manter 50000.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=troque-este-valor
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
